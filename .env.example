# Copy to .env and fill in your key:  cp .env.example .env
# .env is git-ignored. Never commit a real key.

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
# Model that writes answers. claude-opus-5-5 gives higher quality at about 2x the cost.
ANSWER_MODEL=claude-sonnet-5-5
# low keeps the first token fast for short grounded answers: low | medium | high | xhigh | max
ANSWER_EFFORT=low

# --- Database ---
POSTGRES_USER=ask
POSTGRES_PASSWORD=ask
POSTGRES_DB=ask_onboarding
# DATABASE_URL is built from these in docker-compose.yml.

# --- Embeddings (local, via fastembed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Retrieval ---
TOP_K=5
# Below this similarity score the app answers "not in the documents" without calling the LLM.
# Measured with eval/calibrate_threshold.py: off-topic questions score up to 0.53, answerable ones from 0.61.
MIN_SCORE=0.55
# Chunk sizes are in characters (about 4 characters = 1 token). Overlap must be under half the size.
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Uploads ---
MAX_UPLOAD_MB=20
