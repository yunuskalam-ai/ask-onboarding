# Optional: copy to .env to change settings:  cp .env.example .env
# The app runs without a .env file. .env is git-ignored; never commit a real key.

# --- LLM ---
# ollama (default): a local model in the ollama container. Free, no API key needed.
# anthropic: Claude through the Anthropic API. Needs ANTHROPIC_API_KEY below.
LLM_PROVIDER=ollama
# Downloaded automatically on the first `docker compose up` (about 1.9 GB).
OLLAMA_MODEL=qwen2.5:3b

# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# claude-opus-5-5 gives higher quality at about 2x the cost.
ANSWER_MODEL=claude-sonnet-5-5
# low keeps the first token fast for short grounded answers: low | medium | high | xhigh | max
ANSWER_EFFORT=low

# --- Database ---
POSTGRES_USER=ask
POSTGRES_PASSWORD=ask
POSTGRES_DB=ask_onboarding
# DATABASE_URL is built from these in docker-compose.yml.

# --- Embeddings (local, via fastembed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Retrieval ---
TOP_K=5
# Below this similarity score the app answers "not in the documents" without calling the LLM.
# Measured with eval/calibrate_threshold.py: off-topic questions score up to 0.53, answerable ones from 0.61.
MIN_SCORE=0.55
# Chunk sizes are in characters (about 4 characters = 1 token). Overlap must be under half the size.
# 400 beat 800 in eval/run_eval.py: more accurate, and a 45% smaller prompt for the local model.
# After changing these, re-index: docker compose exec api python -m app.reindex
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# --- Uploads ---
MAX_UPLOAD_MB=20

# --- First start ---
# Load sample_docs/ when the database has no documents yet. Never re-adds them later.
SEED_SAMPLE_DOCS=true
