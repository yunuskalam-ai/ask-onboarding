# The only public entry point. Values come from .env (see setup.sh).
# SITE_ADDRESS is a host name such as 1-2-3-4.sslip.io: Caddy gets an HTTPS
# certificate for it automatically. Use http://<ip> for plain HTTP instead.
{$SITE_ADDRESS} {
	basic_auth {
		{$DEMO_USER} {$DEMO_PASSWORD_HASH}
	}
	# Browsers must use HTTPS for this site from now on (nginx can't know the
	# site is HTTPS; Caddy terminates TLS). A year, as is usual.
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:80 {
		# Send chat tokens to the browser as soon as they arrive.
		flush_interval -1
	}
}
